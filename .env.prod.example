# Copy to .env.prod and set secrets. Do not commit .env.prod.

JWT_SECRET=replace-with-at-least-32-bytes-random-secret

# Shared Postgres on Docker network shared_db_net (VPS) — host = service name in infra compose
DATABASE_URL=jdbc:postgresql://postgres:5432/smart_pos
DATABASE_USERNAME=smart_pos
DATABASE_PASSWORD=replace-with-strong-password

# Optional; used by docker-compose.local-db.override.yml bundled Postgres
POSTGRES_DB=smart_pos
POSTGRES_USER=smart_pos

WEB_PORT=80
VITE_API_BASE_URL=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost

# APP_SEED_ENABLED=true
# APP_SEED_PASSWORD=Password123!
